# Lives at /srv/mysite/Caddyfile on the VPS.

calleghermattia.com {
	root * /srv/site
	encode zstd gzip
	file_server

	# One 404 page per language tree. NOT Next's own /404.html — with a root
	# layout per language that file is Next's unstyled fallback; the real
	# pages are routes at /not-found/ and /it/not-found/. Matchers inside a
	# named matcher block are ANDed, and the `not path` on the second is what
	# stops it clobbering the rewrite the first one just made.
	handle_errors {
		@404it {
			expression {err.status_code} == 404
			path /it/*
		}
		rewrite @404it /it/not-found/index.html

		@404en {
			expression {err.status_code} == 404
			not path /it/*
		}
		rewrite @404en /not-found/index.html

		file_server
	}

	# Next writes the generated social cards with no file extension, so give
	# them a type explicitly rather than leaning on content sniffing —
	# X-Content-Type-Options: nosniff is set below.
	@og path /opengraph-image-*
	header @og Content-Type "image/png"

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		# SAMEORIGIN, not DENY: the playground embeds its own demo pages in iframes
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		# script-src needs 'unsafe-inline': Next.js static export bootstraps
		# hydration via inline scripts (and our locale redirect is inline).
		# Nonces are impossible on prebuilt HTML; per-build hashes unmaintainable.
		# frame-ancestors/frame-src 'self': the playground embeds its own demos.
		Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; script-src 'self' 'unsafe-inline'; frame-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'self'"
	}

	# Hashed Next.js assets are immutable — cache hard
	@immutable path /_next/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	# Browsers blindly request /favicon.ico; the real icon is the SVG
	redir /favicon.ico /icon.svg 301
}

www.calleghermattia.com {
	redir https://calleghermattia.com{uri} permanent
}
