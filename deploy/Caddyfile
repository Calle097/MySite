# Lives at /srv/mysite/Caddyfile on the VPS.

calleghermattia.com {
	root * /srv/site
	encode zstd gzip
	file_server

	handle_errors {
		@404 expression {err.status_code} == 404
		rewrite @404 /404.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		# SAMEORIGIN, not DENY: the playground embeds its own demo pages in iframes
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Static export: no inline eval needed, keep a tight CSP.
		# frame-ancestors 'self' (not 'none') for the same playground reason;
		# frame-src 'self' allows the embeds themselves.
		Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; script-src 'self'; frame-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'self'"
	}

	# Hashed Next.js assets are immutable — cache hard
	@immutable path /_next/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"
}

www.calleghermattia.com {
	redir https://calleghermattia.com{uri} permanent
}
