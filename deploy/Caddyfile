# Lives at /srv/mysite/Caddyfile on the VPS.
# Replace example.com with your real domain (2 places).

example.com {
	root * /srv/site
	encode zstd gzip
	file_server

	handle_errors {
		@404 expression {err.status_code} == 404
		rewrite @404 /404.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Static export: no inline eval needed, keep a tight CSP
		Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; script-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
	}

	# Hashed Next.js assets are immutable — cache hard
	@immutable path /_next/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"
}

www.example.com {
	redir https://example.com{uri} permanent
}
