# Lives at /srv/mysite/Caddyfile on the VPS.

calleghermattia.com {
	root * /srv/site
	encode zstd gzip
	file_server

	# One 404 page per language tree. NOT Next's own /404.html — with a root
	# layout per language that file is Next's unstyled fallback; the real
	# pages are routes at /not-found/ and /it/not-found/. Matchers inside a
	# named matcher block are ANDed, and the `not path` on the second is what
	# stops it clobbering the rewrite the first one just made.
	handle_errors {
		@404it {
			expression {err.status_code} == 404
			path /it/*
		}
		rewrite @404it /it/not-found/index.html

		@404en {
			expression {err.status_code} == 404
			not path /it/*
		}
		rewrite @404en /not-found/index.html

		file_server
	}

	# Next writes the generated social cards with no file extension, so give
	# them a type explicitly rather than leaning on content sniffing —
	# X-Content-Type-Options: nosniff is set below.
	@og path /opengraph-image-*
	header @og Content-Type "image/png"

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		# SAMEORIGIN, not DENY: the playground embeds its own demo pages in iframes
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		# script-src needs 'unsafe-inline': Next.js static export bootstraps
		# hydration via inline scripts (and our locale redirect is inline).
		# Nonces are impossible on prebuilt HTML; per-build hashes unmaintainable.
		# style-src likewise: React renders style={{…}} attributes, several of
		# them carrying values computed per render, so they cannot become CSS.
		# base-uri/form-action 'none': the site has no <base> tag and no form,
		# so nothing legitimate is lost and both injection routes close.
		# frame-ancestors/frame-src 'self': the playground embeds its own demos.
		Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; script-src 'self' 'unsafe-inline'; frame-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'self'"
	}

	# Caching. Caddy's file_server sends ETag and Last-Modified but never a
	# Cache-Control, and with no directive at all browsers fall back to
	# heuristic freshness — they invent a lifetime from the file's age and can
	# serve a page for hours without asking.
	#
	# The three matchers below are mutually exclusive by construction, which
	# is the point: a Cache-Control in the header block above, meant as a
	# default for "everything else", silently won over these instead of losing
	# to them, and every asset came out max-age=0. Nothing here overrides
	# anything, so the outcome does not depend on which order Caddy applies
	# repeated header directives in.
	@immutable path /_next/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	# Unhashed, so they cannot be immutable, but they only change on a rebuild.
	@assets path /cv.pdf /icon.svg /opengraph-image-*
	header @assets Cache-Control "public, max-age=86400"

	# Everything left is an HTML page. Revalidate every visit: a cached page
	# referencing hashed chunks a later deploy deleted is a broken site until
	# a hard reload. The ETag makes the check a 304, so it costs one round
	# trip rather than a download.
	@html not path /_next/* /cv.pdf /icon.svg /opengraph-image-*
	header @html Cache-Control "public, max-age=0, must-revalidate"

	# Browsers blindly request /favicon.ico; the real icon is the SVG
	redir /favicon.ico /icon.svg 301
}

www.calleghermattia.com {
	redir https://calleghermattia.com{uri} permanent
}
